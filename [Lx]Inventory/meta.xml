<meta>
  <info author="Linux Game" name="[Lx]Inventory" version="1.0.0" type="script" description="Server-authoritative inventory: slots, weight, drag&amp;drop UI"/>
  <min_mta_version server="1.6.0" client="1.6.0"/>
  <include resource="[Lx]Global"/>
  <include resource="[Lx]Notification"/>

  <script src="items.lua" type="shared"/>
  <script src="server.lua" type="server"/>
  <script src="client.lua" type="client"/>

  <file src="ui/index.html"/><file src="ui/style.css"/><file src="ui/script.js"/>
  <file src="ui/items.js"/><file src="ui/ui.css"/><file src="ui/ui.js"/>
  <file src="ui/fonts/title.woff2"/><file src="ui/fonts/body.woff2"/>

  <!-- other resources: -->
  <export function="addItem"      type="server"/>   <!-- (player, item, count)  -> true | false, reason -->
  <export function="removeItem"   type="server"/>   <!-- (player, item, count)  -> true | false, reason -->
  <export function="getItemCount" type="server"/>   <!-- (player, item)         -> number -->
  <export function="hasItem"      type="server"/>   <!-- (player, item, count?) -> bool -->
  <export function="canCarry"     type="server"/>   <!-- (player, item, count)  -> bool -->
  <export function="getWeight"    type="server"/>   <!-- (player)               -> used, max -->
</meta>
